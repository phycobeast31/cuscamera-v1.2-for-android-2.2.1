<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#000000">

    <!-- Camera preview (aspect-correct, centred) -->
    <com.wildfire.camera.CameraPreview
        android:id="@+id/preview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center" />

    <!-- Touch-focus ring -->
    <View
        android:id="@+id/focus_ring"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/focus_ring"
        android:visibility="gone" />

    <!-- iPhone 3GS style shutter: two black panels meeting in the middle -->
    <LinearLayout
        android:id="@+id/shutter_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:visibility="gone">
        <View
            android:id="@+id/shutter_top"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />
        <View
            android:id="@+id/shutter_bottom"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />
    </LinearLayout>

    <!-- On-screen controls (physical shutter key is broken) -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        android:background="#66000000">

        <ToggleButton
            android:id="@+id/mode_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textOn="VIDEO"
            android:textOff="PHOTO"
            android:checked="false" />

        <Button
            android:id="@+id/capture_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="SHOOT"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settings_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MENU" />
    </LinearLayout>
</FrameLayout>
