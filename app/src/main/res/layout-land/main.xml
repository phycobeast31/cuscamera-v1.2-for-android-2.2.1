<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#000000">

    <com.wildfire.camera.CameraPreview
        android:id="@+id/preview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center" />

    <View
        android:id="@+id/focus_ring"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/focus_ring"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/shutter_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:visibility="gone">
        <View
            android:id="@+id/shutter_top"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />
        <View
            android:id="@+id/shutter_bottom"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />
    </LinearLayout>

    <!-- Landscape: controls in a column on the right -->
    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="fill_parent"
        android:layout_gravity="right"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp"
        android:background="#66000000">

        <ToggleButton
            android:id="@+id/mode_toggle"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textOn="VIDEO"
            android:textOff="PHOTO"
            android:checked="false" />

        <ImageButton
            android:id="@+id/capture_button"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4"
            
            android:src="@drawable/ic_camera"
            android:scaleType="centerInside"
            android:contentDescription="Capture" />

        <Button
            android:id="@+id/settings_button"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="13sp"
            android:text="MENU" />
    </LinearLayout>
</FrameLayout>
